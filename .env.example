NODE_ENV=development
PORT=3000
OBSERVE_APP_KEY=
OBSERVE_APP_SECRET=
LOG_LEVEL=
SWAGGER_ENABLED=
REDIS_URL=redis://localhost:6379
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100
TRUST_PROXY=
SHUTDOWN_GRACE_MS=2000
QUEUE_PREFIX=bull
MAIL_TRANSPORT=smtp
SMTP_URL=smtp://localhost:1025
MAIL_FROM=Backend <no-reply@example.com>
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/slotwise-dev
DATABASE_POOL_MAX=10
# Roles the app switches to: RLS applies to the app role; the admin one bypasses it (admin/job code only)
DATABASE_APP_ROLE=slotwise_app
DATABASE_ADMIN_ROLE=slotwise_admin
# Auth (F02). JWT_SECRET: 32+ bytes, required in production (openssl rand -base64 32).
JWT_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d
# Sign-in, magic-link and reset attempts per minute, per IP and per email
AUTH_THROTTLE_LIMIT=5
# Nightly cleanup (F15): delete never-verified, unused customer accounts after this many days
UNVERIFIED_ACCOUNT_RETENTION_DAYS=7
# Team invitation emails (add member, resend setup) per business per hour (F04)
MEMBER_INVITE_LIMIT=20
# Web app base URL used in emailed links (account setup, magic link, password reset)
APP_URL=http://localhost:5173
# Public base URL of this API; social sign-in callbacks are
# ${API_URL}/auth/customer/oidc/<google|microsoft>/callback (register them with each provider)
API_URL=http://localhost:3000
# Customer social sign-in (F02 v2). A provider is on only when its id AND secret are set.
# Google: Cloud console > APIs & Services > Credentials > OAuth client ID (Web application)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Microsoft: Entra app registration, "Personal Microsoft accounts only"
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# Tenant GUID, required with the two above (no default). Personal Microsoft accounts:
# 9188040d-6c67-4c5b-b112-36a304b66dad; one organisation only: its own tenant id
MICROSOFT_TENANT_ID=
# Seed only (npm run db:seed): the one platform admin. Password: 10+ chars, not a common one.
PLATFORM_ADMIN_EMAIL=admin@slotwise.local
PLATFORM_ADMIN_PASSWORD=
PLATFORM_ADMIN_NAME=Platform Admin
